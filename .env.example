# ===== LINE Bot Credentials (from LINE Developers Console: https://developers.line.biz/) =====
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# ===== AI 模型後端 =====
# "gemini"（預設）或 "openai"（OpenAI 相容 API，可接開源模型）
LLM_BACKEND=gemini

# Google Gemini (from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash

# OpenAI 相容 API（開源模型後端）
# 本地 Ollama 範例（免費、完全離線）：
#   LLM_BACKEND=openai
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   OPENAI_MODEL=qwen2.5:7b
# OpenRouter 範例（雲端開源模型）：
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=qwen2.5:7b

# ===== Security =====
# Allowed LINE User IDs (comma-separated).
# Leave empty to allow any user to chat, but it is strongly recommended
# to restrict command execution to your own LINE user ID for security.
ALLOWED_USER_IDS=

# ===== Webhook Server =====
PORT=5000

# ===== 對話紀錄持久化目錄（伺服器重啟後仍保留記憶） =====
CHAT_HISTORY_DIR=chat_history

# ===== 速率限制（每 RATE_LIMIT_WINDOW 秒最多 RATE_LIMIT_REQUESTS 則訊息） =====
RATE_LIMIT_REQUESTS=12
RATE_LIMIT_WINDOW=60
